# Root compose defaults (safe for local self-host / dev)
# Copy to .env to override.

# --- app ports (host) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- database ---
POSTGRES_DB=mission_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- backend settings (see backend/.env.example for full list) ---
# REQUIRED: Public URL the backend should advertise in generated instructions/webhook flows.
# Update this when the backend is served behind a reverse proxy, custom host, or non-default port.
BASE_URL=http://localhost:8000
# For remote access, set this to your UI origin (e.g. http://<server-ip>:3000 or https://mc.example.com).
CORS_ORIGINS=http://localhost:3000
DB_AUTO_MIGRATE=true
LOG_LEVEL=INFO
REQUEST_LOG_SLOW_MS=1000
AUTH_MODE=local
# REQUIRED when AUTH_MODE=local (must be non-placeholder and at least 50 chars).
LOCAL_AUTH_TOKEN=

# --- backend settings for AUTH_MODE=betterauth ---
# The FastAPI backend verifies the Next.js app's Better Auth JWTs against its
# published JWKS, statelessly (no Google, no Better Auth call on the request
# path). All of the first two are required when AUTH_MODE=betterauth — the
# backend refuses to start without them. See docs/reference/authentication.md.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
# Optional: the 'aud' to expect. Defaults to BETTER_AUTH_ISSUER.
# BETTER_AUTH_AUDIENCE=http://localhost:3000

# --- frontend settings ---
# REQUIRED: Public URL used by the browser to reach the API.
# Use `auto` to target the same host currently serving Mission Control on port 8000.
# Example (explicit override): NEXT_PUBLIC_API_URL=https://mc.example.com
NEXT_PUBLIC_API_URL=auto
# --- Better Auth (Google) in the frontend service ---
# The Next.js app runs a Better Auth server at /api/auth/* (Google sign-in,
# JWKS/JWT for the backend, API keys). Unset = /api/auth/* fails fast with a
# clear error; the local auth flow keeps working. See
# docs/reference/authentication.md ("Better Auth (Google)").

# 32+ chars, non-placeholder. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated Google Workspace domains allowed to sign in ("hd" claim).
BETTER_AUTH_ALLOWED_GOOGLE_DOMAINS=
# Public origin of the frontend, e.g. http://localhost:3000 (JWT iss + aud).
BETTER_AUTH_BASE_URL=http://localhost:3000
# Derived below in compose.yml from POSTGRES_* (plain postgresql://, not the
# SQLAlchemy-prefixed DATABASE_URL):
# BETTER_AUTH_DATABASE_URL=postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@db:5432/${POSTGRES_DB:-mission_control}

# --- shared OpenClaw workspace (read-only mount for transcript browsing) ---
# Host path mounted into backend containers for the admin Transcriptions view.
OPENCLAW_SHARED_WORKSPACE_PATH=${HOME}/.openclaw-docker/workspace
# Optional: override Hugging Face cache mount used by backend/worker containers.
OPENCLAW_HUGGINGFACE_CACHE_PATH=${HOME}/.cache/huggingface

# --- shared OpenClaw backend base image ---
# Mission Control builds its backend image on top of the shared OpenClaw
# WhisperX/PyTorch base. Keep CPU as the default, or set `cu128` to use the GPU
# variant after running `./scripts/ensure_openclaw_backend_base.sh`.
OPENCLAW_TORCH_BACKEND=cpu
# Override this if you publish the shared base to a registry.
# Example: ghcr.io/your-org/openclaw-whisperx-base
OPENCLAW_BACKEND_BASE_REPOSITORY=openclaw-whisperx-base

# --- OpenRouter API key (used by scripts) ---
OPENROUTER_API_KEY=
