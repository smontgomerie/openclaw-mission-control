# Base URL for frontend -> backend calls.
# Use `auto` to target the same host currently serving Mission Control on port 8000.
# Example explicit override: https://mc.example.com
NEXT_PUBLIC_API_URL=auto

# Auth mode: betterauth or local.
# - betterauth: Google sign-in flow (Better Auth in this app)
# - local: shared bearer token entered in UI
NEXT_PUBLIC_AUTH_MODE=local

# Where unauthenticated clicks land (optional; default /onboarding).
NEXT_PUBLIC_SIGN_IN_FALLBACK_REDIRECT_URL=/boards

# Better Auth server (Google sign-in at /api/auth/*)
# Runs in this Next.js app; the Python backend verifies its JWTs via /api/auth/jwks.
# Unset = the /api/auth/* routes fail fast with a clear error; the local flow is unaffected.
# See docs/reference/authentication.md ("Better Auth (Google)" section).

# 32+ chars, non-placeholder. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Google OAuth client (OAuth client ID / Client secret from the Google Cloud Console).
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated Google Workspace domains allowed to sign in (matched against the
# "hd" claim; accounts without "hd" are refused). Example: acme.com
BETTER_AUTH_ALLOWED_GOOGLE_DOMAINS=
# Public origin of this app, e.g. http://localhost:3000. Used as the JWT issuer AND audience.
BETTER_AUTH_BASE_URL=http://localhost:3000
# Same value, exposed to the browser so Google OAuth can bounce non-canonical
# origins (localhost HTTP) onto this HTTPS/public origin before setting cookies.
NEXT_PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:3000
# Plain postgresql:// URL for the shared db service. The backend's DATABASE_URL uses a
# postgresql+psycopg:// SQLAlchemy prefix and is NOT reusable here.
BETTER_AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control
